        {
          "id": "c2222375-4e6b-48c8-a34c-0b9407625eba",
          "name": "Get Top PPC Competitors",
          "request": {
            "name": "Get Top PPC Competitors",
            "description": {
              "content": "Returns the top paid search (PPC) competitors for a domain based on shared keyword advertising overlap. This endpoint identifies domains that compete for the same paid keywords to reveal direct advertising competition and bidding opportunities.\n\n[Visualize this API live on SpyFu](https://www.spyfu.com/ppc/competitors?query=example.com)",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "ppc",
                "getTopCompetitors"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "domain",
                  "value": "<string>",
                  "description": "(Required) Domain to analyze for paid search competitors."
                },
                {
                  "disabled": false,
                  "key": "countryCode",
                  "value": "US",
                  "description": "Country market to search.  Specifically, this maps to the Google domain version to query against (e.g., google.com for US, google.de for Germany, etc.).  <a href='https://developer.spyfu.com/reference/adhistoryapi_getdomainadhistory_get#/'>All Countries</a>"
                },
                {
                  "disabled": false,
                  "key": "sortBy",
                  "value": "Rank",
                  "description": "Column to sort by."
                },
                {
                  "disabled": false,
                  "key": "sortOrder",
                  "value": "Descending",
                  "description": "Order to sort results."
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "5",
                  "description": "The maximum number of rows returned."
                },
                {
                  "disabled": false,
                  "key": "startingRow",
                  "value": "1",
                  "description": "Row number to start the results with."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
